# NodeMonitor environment variables (names only — never commit real values).
# Copy to .env.local (git-ignored) and fill in. No localhost literals in source code;
# the local nodemon URL lives ONLY here / in .env.local.

# LND routing warehouse — read-only (nodemon_ro role), e.g.
#   postgres://nodemon_ro:***@192.243.215.101:5432/routing_vm?sslmode=prefer
ROUTING_VM_DATABASE_URL=

# LDK/LSPD warehouse — read-only (nodemon_ro role), e.g.
#   postgres://nodemon_ro:***@192.243.215.101:5432/ldk-lspd-main?sslmode=prefer
LDK_LSPD_DATABASE_URL=

# Local nodemon queue DB — read-write (nodemon_rw role), e.g.
#   postgres://nodemon_rw:***@localhost:5432/nodemon
NODEMON_QUEUE_URL=

# Pooler flag (D-03): set true ONLY if a transaction-mode PgBouncer fronts the warehouse.
WAREHOUSE_PG_TXN_POOLER=false

# =====================================================
# Command queue — signing + TTL + reaper contract (Phase 6)
# =====================================================

# Per-node HMAC signing secret (D-12). ONE variable PER NODE, keyed by the node's
# pubkey. This key FORM is FROZEN (A3) — Phase 7's bash downloader resolves the
# SAME variable name to verify signatures via `openssl dgst -sha256 -hmac`.
#
#   NODEMON_HMAC_SECRET_<pubkey>
#
# Rules (NON-NEGOTIABLE — T-06-01):
#   - <pubkey> is the FULL 66-hex-char node pubkey (compressed secp256k1: 02/03
#     prefix + 64 hex), used VERBATIM as the env-key suffix. Node pubkeys are pure
#     [0-9a-f] and are valid POSIX env-name characters as-is, so NO transform is
#     applied — the suffix is byte-identical to the on-node pubkey string. (If a
#     future non-hex key form is ever introduced, the exact transform MUST be
#     documented here before Phase 7 mirrors it.)
#   - server-only: loaded in server code (sign.ts) via process.env — NEVER read
#     into any client bundle, NEVER exposed to the browser.
#   - never-in-DB: there is NO secret column on any nodemon table. Storing the
#     secret in the DB would hand the key to the tampered-row threat HMAC defends
#     against. The DB holds only the canonical payload + the hex signature.
#   - per-node: each node has its OWN secret — NEVER a shared dashboard master.
#   - Value: operator-generated random 32+ byte hex string, unique per node.
#
# Example (placeholder pubkey — replace with a real one; value shown is a sample):
#   NODEMON_HMAC_SECRET_03abcdef0123456789abcdef0123456789abcdef0123456789abcdef01234567=<64-hex-random>
#
# PHASE 6 REQUIREMENT: a TEST secret keyed by a TEST pubkey MUST exist in your
# git-ignored .env.local so the Wave 2 sign/enqueue integration tests run, e.g.
#   NODEMON_HMAC_SECRET_<test-pubkey>=<any-32+byte-hex-test-value>

# Command TTL in hours (D-11). expires_at = enqueue time + NODEMON_TTL_HOURS.
# Config-tunable; default 24 if unset. The reaper fail-closes (expires) any
# non-terminal pre-execution command past expires_at.
NODEMON_TTL_HOURS=24

# Stale-claim reaper window in milliseconds (D-14). A row stuck in `claimed`
# longer than this (claimed_at < now() - NODEMON_CLAIMED_TIMEOUT_MS) is reaped
# back so it can be re-claimed (no double-apply: re-claim only re-enters the
# pipeline, it does not re-execute a succeeded job).
# PROVISIONAL default below — Phase 7 sets the REAL value once the node-side
# cron heartbeat cadence is fixed (the timeout must exceed one heartbeat round-trip).
NODEMON_CLAIMED_TIMEOUT_MS=300000

# =====================================================
# App tunables (OPTIONAL — the boot health check does NOT require these)
# =====================================================
# HARDEN-02: the local->VM flip is env-only. The three DB URLs above are the ONLY
# vars runStartupHealthCheck() hard-requires (a missing one fails the boot LOUD by
# name — no localhost default). The vars below are OPTIONAL app behaviour toggles
# read on the boot/config path; they have safe in-code defaults but are documented
# here so the VM-flip env contract is complete and nothing is discovered by surprise.

# Per-node backend override map (D-03), JSON: { "<pubkey>": "lnd" | "ldk" }.
# Unset -> the built-in DEFAULT_BACKENDS map, then "lnd". Parsed ONCE at boot and
# FAIL-LOUD: malformed JSON or a value other than "lnd"/"ldk" throws at startup.
NODE_BACKENDS=

# Operator identity stamped on incident-tracking actions (ack/mute attribution).
# Unset -> actions fall back to an anonymous/default operator label.
NODEMON_OPERATOR_ID=

# Optional AI narration layer (off by default; the deterministic cards are the
# source of truth). INSIGHT_LLM_ENABLED must be exactly "true" to enable narration;
# AI_MODEL overrides the default Claude model id (workspace getModel() convention).
INSIGHT_LLM_ENABLED=false
AI_MODEL=
