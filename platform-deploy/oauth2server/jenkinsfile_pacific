pipeline {
    agent none
  //post { 
  //      always { 
  //          cleanWs()
  //     }
  // }
    parameters {
        
        booleanParam(name: 'checkDataChange', defaultValue: true, description: 'check data change before running the pipeline')
        
    }
    environment {
       GIT_SSH_COMMAND = "ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no"
       PROJECT_NAME = "oauth2server"
       PROJECT_FOLDER = 'oauth2server'
       registry = '172.16.102.160:32000/oauth2server'
       gitUrl = 'git@github.com:lightningriders/platform.git'
       gitCredential = 'github-ssh'
       gitBranch = 'main'
       k8sNamespace = 'oauth2'
       environment = 'prod'
       KUBE_CONFIG_ID = "kubeconfig-pacific-jenkins"
    }
    
    tools {
    maven 'm3'
    }
    
  stages {
      
    stage('Checkout Source') {
       agent {
           label "master"
        }
        steps {
            cleanWs()
            //sh "ssh -o StrictHostKeyChecking=no git@github.com"
            git credentialsId: gitCredential , url: gitUrl , branch: gitBranch
            sh "ls -la"
        }
    }
    

    stage('Build') {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
           label "master"
        }
        steps {
          dir("${env.PROJECT_FOLDER}") {
            //sh 'mvn -version'
            sh 'mkdir build'
            sh 'cp pom.xml build/'
            sh 'cp -r src build/'
            sh '''
                  cd build
                  mvn clean package -Dmaven.test.skip=true -e
              '''
            sh 'ls -la build/'
          }
        }
    }
      
    stage ('Test') {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
           label "master"
        }
        steps {
          dir("${env.PROJECT_FOLDER}") {
            sh 'echo \'Here we have to run tests\''
          }
        }
    }
    
    stage ('Build Image') {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
           label "master"
        }
        steps {
          dir("${env.PROJECT_FOLDER}") {
            script {
                dockerImage = docker.build registry + ":" + "$environment-$BUILD_NUMBER"
            }
          }
        }
    }
    
    stage("Push image") {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
           label "master"
        }
        steps {
          script {
                docker.withRegistry("https://" + registry , "") {
                    dockerImage.push(environment + "-latest")
                    dockerImage.push(environment + "-$BUILD_NUMBER")
                }
            }
          }
        }
    }

    stage('Deploy App') {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
         kubernetes {
        	cloud 'kubernetes-aws'
      	    defaultContainer 'jnlp'
         }
        }
        steps {
            git credentialsId: gitCredential, url: gitUrl, branch: gitBranch
            dir("${env.PROJECT_NAME}") {
              script {
                  sh 'kubectl apply -f oauth2-deployment-master.yml'
                  sh 'kubectl apply -f oauth2-service-master.yml'
              }
            }
        }
    }
    stage('Remove Unused docker image') {
      when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
      }
      agent {
           label "master"
      }
      steps{
        sh "docker rmi $registry:$environment-$BUILD_NUMBER"
      }
    }
  }
}
