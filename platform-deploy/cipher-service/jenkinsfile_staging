pipeline {
    agent none
    parameters {
        //string(name: 'PERSON', defaultValue: 'Mr Jenkins', description: 'Who should I say hello to?')

        //text(name: 'BIOGRAPHY', defaultValue: '', description: 'Enter some information about the person')

        booleanParam(name: 'checkDataChange', defaultValue: true, description: 'check data change before running the pipeline')

        //choice(name: 'CHOICE', choices: ['One', 'Two', 'Three'], description: 'Pick something')

        //password(name: 'PASSWORD', defaultValue: 'SECRET', description: 'Enter a password')
    }
//========================= Only For Testing ============================
    environment {
       GIT_SSH_COMMAND = "ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no"
       PROJECT_NAME = "cipher-service"
       PROJECT_FOLDER = 'cipher-service'
       registry = '514063904685.dkr.ecr.us-west-2.amazonaws.com/cipher-service'
       registryCredential = 'aws-ecr'
       gitUrl = 'git@github.com:lightningriders/platform.git'
       gitCredential = 'github-ssh'
       gitBranch = 'staging'
       k8sNamespace = 'microservice'
       environment = 'staging'
       KUBE_CONFIG_ID = "kubeconfig-aws-stage1-jenkins"
    }
 //======================================================================   
    tools {
    maven 'm3'
    }
    
  stages {
      
    stage('Checkout Source') {
       agent {
           label "master"
        }
        steps {
            cleanWs()
            //sh "ssh -o StrictHostKeyChecking=no git@github.com"
            git credentialsId: gitCredential, url: gitUrl, branch: gitBranch 
            sh "ls -la"
        }
    }
    

    stage('Build') {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
           label "master"
        }
        steps {
          dir("${env.PROJECT_NAME}") {
            sh 'mkdir build'
            sh 'cp pom.xml build/'
            sh 'cp -r src build/'
            sh '''
                  cd build
                  mvn clean package -Dmaven.test.skip=true
              '''
            sh 'ls -la build/'
          }
        }
    }
      
    stage ('Test') {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
           label "master"
        }
        steps {
          dir("${env.PROJECT_NAME}") {
            sh 'echo \'Here we have to run tests\''
          }
        }
    }
    
    stage ('Build Image') {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
           label "master"
        }
        steps {
          dir("${env.PROJECT_NAME}") {
            script {
                dockerImage = docker.build registry + ":" + "$environment-$BUILD_NUMBER"
            }
          }
        }
    }
   
//    stage("create repository if not exist"){
//        dir("${env.PROJECT_NAME}") {
//            sh "aws ecr describe-repositories --repository-names ${PROJECT_NAME} || aws ecr create-repository --repository-name ${PROJECT_NAME}"
//        }
//    }
    
    stage("Push image") {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
           label "master"
        }
        steps {
            script {
                docker.withRegistry("https://" + registry , "ecr:us-west-2:" + registryCredential) {
                    dockerImage.push(environment + "-latest")
                    dockerImage.push(environment + "-$BUILD_NUMBER")
                }
            }
        }
    }

    stage('Deploy App') {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
         kubernetes {
        	cloud 'kubernetes'
      	    defaultContainer 'jnlp'
         }
        }
        steps {
            git credentialsId: gitCredential, url: gitUrl, branch: gitBranch
            dir("${env.PROJECT_NAME}") {
              script {
                  //kubernetesDeploy( kubeconfigId: "${env.KUBE_CONFIG_ID}",
                  //                  configs: "namespace.yml"
                  //                )
                  //sleep(time:5,unit:"SECONDS")
                  kubernetesDeploy( kubeconfigId: "${env.KUBE_CONFIG_ID}",
                                    configs: "cipher-staging-dp.yaml"
                                    // ,
                                    // secretName: 'ecr-token',
                                    // dockerCredentials: [
                                    //     [credentialsId: 'ecr:us-west-2:aws-ecr', url: registry]
                                    // ],
                                    // secretNamespace: k8sNamespace
                                  )
                  kubernetesDeploy( kubeconfigId:  "${env.KUBE_CONFIG_ID}",
                                    configs: "cipher-service.yaml"
                                  )
                  /*kubernetesDeploy( kubeconfigId: "${env.KUBE_CONFIG_ID}",
                                    configs: "ingress.yml"
                                  )*/
              }
            }
        }
    }
    stage('Remove Unused docker image') {
      when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
      }
      agent {
           label "master"
      }
      steps{
        sh "docker rmi $registry:$environment-$BUILD_NUMBER"
      }
    }
  }
}