pipeline {
    agent none
  //post { 
  //      always { 
  //          cleanWs()
  //     }
  // }
    environment {
       GIT_SSH_COMMAND = "ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no"
       registry = '514063904685.dkr.ecr.us-west-2.amazonaws.com/oauth2server'
       registryCredential = 'aws-ecr'
    }
    
    tools {
    maven 'm3'
    }
    
  stages {
      
    stage('Checkout Source') {
       agent {
           label "master"
        }
        steps {
            cleanWs()
            //sh "ssh -o StrictHostKeyChecking=no git@github.com"
            git credentialsId: 'github-ssh', url:'git@github.com:lightningriders/oauth2server.git', branch:'cicd'
            sh "ls -la"
        }
    }
    

    stage('Build') {
        agent {
           label "master"
        }
        steps {
          //sh 'mvn -version'
          sh 'mkdir build'
          sh 'cp pom.xml build/'
          sh 'cp -r src build/'
          sh '''
                cd build
                mvn clean package -Dmaven.test.skip=true
            '''
          sh 'ls -la build/'
        }
    }
      
    stage ('Test') {
        agent {
           label "master"
        }
        steps {
          sh 'echo \'Here we have to run tests\''
        }
    }
    
    stage ('Build Image') {
        agent {
           label "master"
        }
        steps {
            script {
                dockerImage = docker.build registry + ":$BUILD_NUMBER"
            }
        }
    }
    
    stage("Push image") {
        agent {
           label "master"
        }
        steps {
            script {
                    docker.withRegistry("https://" + registry, "ecr:us-west-2:" + registryCredential) {
                    dockerImage.push("latest")
                    dockerImage.push("${env.BUILD_ID}")
                }
            }
        }
    }

    stage('Deploy App') {
        agent {
         kubernetes {
        	cloud 'kubernetes'
      	    defaultContainer 'jnlp'
         }
        }
        steps {
            git credentialsId: 'github-ssh', url:'git@github.com:lightningriders/oauth2server.git', branch:'cicd'
            script {
                 kubernetesDeploy( kubeconfigId: 'stage-k8s-local',
                                   configs: "namespace.yml"
                                 )
                 sleep(time:5,unit:"SECONDS")
                 kubernetesDeploy( kubeconfigId: 'stage-k8s-local',
                                   configs: "oauth2-deployment-cicd.yml",
                                   secretName: 'ecr-token',
                                   dockerCredentials: [
                                       [credentialsId: 'ecr:us-west-2:aws-ecr', url: registry]
                                   ],
                                   secretNamespace: 'oauth2'
                                 )
                 kubernetesDeploy( kubeconfigId: 'stage-k8s-local',
                                   configs: "oauth2-service-cicd.yml"
                                 )
                 /*kubernetesDeploy( kubeconfigId: 'stage-k8s-local',
                                   configs: "ingress.yml"
                                 )*/
            }
        }
    }
  }
