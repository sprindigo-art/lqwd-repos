pipeline {
    agent none
  //post { 
  //      always { 
  //          cleanWs()
  //     }
  // }
    environment {
       GIT_SSH_COMMAND = "ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no"
       registry = '514063904685.dkr.ecr.us-west-2.amazonaws.com/frontend'
       registryCredential = 'aws-ecr'
       gitUrl = 'git@github.com:lightningriders/frontend.git'
       gitCredential = 'github-ssh'
       gitBranch = 'master'
       k8sNamespace = 'microservice'
       kubeconfig = 'kubeconfig-aws1-jenkins'
       cf_url = 'https://api.cloudflare.com/client/v4/zones/67a7cb4520c351b3c06f6d5300a3da08/purge_cache'
       cf_api = credentials('cf_api')
    }
    
    tools {
    maven 'm3'
    }
    
  stages {
      
    stage('Checkout Source') {
       agent {
           label "master"
        }
        steps {
            cleanWs()
            //sh "ssh -o StrictHostKeyChecking=no git@github.com"
            git credentialsId: gitCredential, url: gitUrl, branch: gitBranch 
            sh "ls -la"
        }
    }
    

    stage('Build') {
        agent {
           label "master"
        }
        steps {
          //sh 'mvn -version'
          sh 'mkdir build'
          sh 'cp pom.xml build/'
          sh 'cp -r src build/'
          sh '''
                cd build
                mvn clean package -Dmaven.test.skip=true
            '''
          sh 'ls -la build/'
        }
    }
      
    stage ('Test') {
        agent {
           label "master"
        }
        steps {
          sh 'echo \'Here we have to run tests\''
        }
    }
    
    stage ('Build Image') {
        agent {
           label "master"
        }
        steps {
            script {
                dockerImage = docker.build registry + ":pr.$BUILD_NUMBER"
            }
        }
    }
    
    stage("Push image") {
        agent {
           label "master"
        }
        steps {
            script {
                    docker.withRegistry("https://" + registry, "ecr:us-west-2:" + registryCredential) {
                    dockerImage.push("pr.$BUILD_NUMBER")
                    dockerImage.push("${env.BUILD_ID}")
                }
            }
        }
    }

    stage('Deploy App') {
        agent {
         kubernetes {
        	cloud 'kubernetes-aws'
      	    defaultContainer 'jnlp'
         }
        }
        steps {
            git credentialsId: gitCredential, url: gitUrl, branch: gitBranch
            script {
                 kubernetesDeploy( kubeconfigId: kubeconfig,
                                   configs: "namespace.yml"
                                 )
                 sleep(time:5,unit:"SECONDS")
                 kubernetesDeploy( kubeconfigId: kubeconfig,
                                   configs: "frontend-deployment-master.yml",
                                   secretName: 'ecr-token',
                                   dockerCredentials: [
                                       [credentialsId: 'ecr:us-west-2:aws-ecr', url: registry]
                                   ],
                                   secretNamespace: k8sNamespace
                                 )
                 kubernetesDeploy( kubeconfigId: kubeconfig,
                                   configs: "frontend-service-master.yml"
                                 )
                //  kubernetesDeploy( kubeconfigId: kubeconfig,
                //                   configs: "ingress.yml"
                //                  )
            }
        }
    }
    stage("Purge CF Cache") {
        agent {
           label "master"
        }
        steps {
          sh 'echo \'Purgin CF cache\''
          sh """curl -X POST $cf_url -H "Content-Type:application/json" -H "Authorization: Bearer $cf_api" --data '{"purge_everything":true}'"""
        }
    }
  }
