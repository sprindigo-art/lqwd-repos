# LND Gateway — Environment Variables
# Copy to .env and fill in values. See internal/config/config.go for all defaults.

# Server
# GATEWAY_LISTEN=127.0.0.1:7778                  # Bind localhost-only; external access
#                                                 # terminates at Caddy on :443 and
#                                                 # proxies back here. See scripts/Caddyfile
#                                                 # and scripts/ufw-cloudflare-ips.sh.
# GATEWAY_MOCK=true                              # Mock mode (no real LND needed)

# Authentication (two-token system)
# GATEWAY_AGENT_TOKEN=                            # Token for OpenClaw agent
# GATEWAY_ADMIN_TOKEN=                            # Token for human/confirm-bot

# LND connection
# LND_GRPC_HOST=127.0.0.1:10009
# LND_TLS_CERT_PATH=
# LND_MACAROON_DIR=/lnd/data/chain/bitcoin/mainnet

# Budget enforcement
# MAX_CHANNEL_SIZE_SATS=5000000
# MAX_PAYMENT_SATS=1000000
# MAX_DAILY_SPEND_SATS=10000000
# MAX_FEE_RATE_SAT_VB=100

# Rate limiting
# RATE_LIMIT_READ=60
# RATE_LIMIT_WRITE=10

# L402 protocol
# L402_ENABLED=true
# L402_SIGNING_KEY=                               # 64-char hex (32 bytes) — generate: openssl rand -hex 32
# L402_DB_PATH=data/l402.db
# L402_TOKEN_EXPIRY=86400                         # Token TTL in seconds (default: 24h)
# L402_INVOICE_EXPIRY=600                         # Invoice expiry in seconds (default: 10min)
# MAX_L402_PAYMENT_SATS=1000

# Cloudflare Access (Phase 10 — internal endpoints)
# CF_ACCESS_TEAM=lqwd                             # CF Zero Trust team domain
# CF_ACCESS_AUD=abc123...                         # CF Access application audience tag
# INTERNAL_AUTH_SECRET=                            # 32+ byte hex (generate: openssl rand -hex 32)

# Admin Dashboard (Phase 15)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=                            # bcrypt hash: generate with: htpasswd -bnBC 12 "" 'yourpassword' | tr -d ':\n'

# Channel Faucet (Phase 14)
# FAUCET_CHANNEL_SIZE_SATS=20000                  # Channel size in sats (default: 20000 — LND minchansize floor)
# FAUCET_PUSH_SATS=1354                           # Sats pushed to peer on open (default: 1354 = 1000 spendable + 354 dust/reserve)
# FAUCET_CHANNEL_CAP=100                          # Max total channel grants (default: 100)
# ADMIN_TOKEN=                                     # Required for admin endpoints (e.g., unban pubkey)
