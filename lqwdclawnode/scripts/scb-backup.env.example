# /etc/lnd-gateway/scb-backup.env — SCB backup configuration
# Copy to /etc/lnd-gateway/scb-backup.env and edit. chmod 600.

# Path to LND's channel.backup file
SCB_PATH=/lnd/data/chain/bitcoin/mainnet/channel.backup

# Local backup storage
BACKUP_DIR=/var/lib/lnd-gateway/scb-backups

# age encryption public key (generate keypair: age-keygen -o key.txt)
# Store the private key OFFLINE, NOT on the VM
AGE_RECIPIENT=

# Remote rsync destination (optional but strongly recommended)
# Example: backupuser@remote-host:/backups/lqwdclaw-scb/
REMOTE_DEST=

# Max local backups to keep (oldest pruned first)
MAX_LOCAL_BACKUPS=50
