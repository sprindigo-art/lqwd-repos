# /etc/lnd-gateway/env — Environment variables for lnd-gateway systemd service
# Copy to /etc/lnd-gateway/env and fill in real values. chmod 600.
#
# ─────────────────────────────────────────────────────────────────────
# INTERNAL OPERATOR CONFIG — v1 SCOPE NOTICE
# This file exposes configuration for ALL system capabilities, including
# subsystems (L402 pay-per-call, credit proxy, paid MCP data tools, tier
# upgrades) that remain present in the code but are NOT part of
# LQWDClaw's v1 publicly advertised surface. LQWDClaw offers the free
# channel faucet only at this time; paid liquidity is a later version.
# Variables for non-advertised subsystems are kept for operator use and
# future re-activation.
# ─────────────────────────────────────────────────────────────────────

# Gateway listens on localhost only (OpenClaw connects locally)
GATEWAY_LISTEN=127.0.0.1:7778

# Mock mode — set to false for production with real LND
GATEWAY_MOCK=true

# Authentication tokens (generate with: openssl rand -hex 32)
GATEWAY_AGENT_TOKEN=CHANGE_ME_agent_token_here
GATEWAY_ADMIN_TOKEN=CHANGE_ME_admin_token_here

# LND connection (ignored when GATEWAY_MOCK=true)
LND_GRPC_HOST=127.0.0.1:10009
LND_TLS_CERT_PATH=/lnd/tls.cert
LND_MACAROON_DIR=/lnd/data/chain/bitcoin/mainnet

# Scoped macaroon filenames (defaults shown — override only if using custom names)
# LND_READONLY_MACAROON=readonly.macaroon
# LND_INVOICE_MACAROON=invoice.macaroon
# LND_CHANNEL_MACAROON=channeladmin.macaroon
# LND_PAY_MACAROON=pay.macaroon

# Data directory for audit DB, idempotency DB, kill switch file
GATEWAY_DATA_DIR=/var/lib/lnd-gateway

# Budget limits (sats)
MAX_CHANNEL_SIZE_SATS=5000000
MAX_PAYMENT_SATS=1000000
MAX_REBALANCE_FEE_SATS=10000
MAX_DAILY_SPEND_SATS=10000000
MAX_FEE_RATE_SAT_VB=100

# Confirmation expiry (seconds)
CONFIRM_EXPIRY_SECONDS=300

# Rate limiting (requests per minute)
# RATE_LIMIT_READ=60
# RATE_LIMIT_WRITE=10

# Kill switch file path
# KILL_SWITCH_PATH=/var/lib/lnd-gateway/kill-switch

# Audit paths — MUST be absolute paths under a writable directory.
# Relative paths will fail under systemd ProtectSystem=strict.
AUDIT_DB_PATH=/var/lib/lnd-gateway/audit.db
AUDIT_FALLBACK_PATH=/var/lib/lnd-gateway/audit-fallback.jsonl

# ─── L402 Pay-Per-Call API ───────────────────────────────────────────
# Enable L402 endpoints (set to true to activate /v1/l402/* routes)
L402_ENABLED=false

# HMAC signing key for L402 macaroons (required when L402_ENABLED=true in production)
# Generate with: openssl rand -hex 32
# Must be exactly 64 hex characters. Gateway will refuse to start without it
# when L402 is enabled and GATEWAY_MOCK=false.
# L402_SIGNING_KEY=

# L402 token lifetime in seconds (default: 86400 = 24 hours)
# L402_TOKEN_EXPIRY=86400

# L402 invoice expiry in seconds (default: 600 = 10 minutes)
# L402_INVOICE_EXPIRY=600

# SQLite database path for L402 token store
# MUST be an absolute path in production (relative paths fail under systemd ProtectSystem=strict)
L402_DB_PATH=/var/lib/lnd-gateway/l402.db

# Max sats allowed for a single outbound L402 client payment (via /v1/l402/pay)
# MAX_L402_PAYMENT_SATS=1000

# ─── v2.0 Faucet Onboarding System ─────────────────────────────────

# PostgreSQL connection for account system (agents, credits, channel grants)
# Tables are auto-created on first startup
# DATABASE_URL=postgresql://gateway_user:PASSWORD@127.0.0.1/lqwdclaw_gateway?sslmode=disable

# Cloudflare Access (required for external /v1/internal/* access)
# CF_ACCESS_TEAM=lqwd
# CF_ACCESS_AUD=YOUR_APPLICATION_AUD_TAG

# Defense-in-depth shared secret for X-Internal-Auth header
# Generate with: openssl rand -hex 32
# INTERNAL_AUTH_SECRET=

# Faucet configuration
# FAUCET_DAILY_CAP_SATS=10000
# FAUCET_CHANNEL_SIZE_SATS=100000
# FAUCET_PUSH_SATS=25000
# FAUCET_CHANNEL_CAP=100

# Credit proxy pricing
# PROXY_PRICE_SATS=10
# PROXY_UPSTREAM_TIMEOUT_SECS=30

# Admin dashboard (required to enable /admin/ UI)
# Generate hash with: python3 -c "import bcrypt; print(bcrypt.hashpw(b'PASSWORD', bcrypt.gensalt()).decode())"
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=

# MCP server billing (optional — disabled by default)
# MCP_BILLING_ENABLED=false
