# Copied to /vm/testbed/compose/.env by scripts/60-sync-testbed.sh.
# The bitcoind RPC password lives in ../secrets/bitcoind-rpc.env instead,
# generated by 61-testbed-up.sh so it never enters git.

# Public address clients dial to reach the VPN.
VPN_PUBLIC_HOST=192.243.215.98
VPN_PORT=1194

VPN_NET=10.99.0.0
VPN_MASK=255.255.255.0

# Fixed VPN addresses. Must match the Pi's baked-in client config.
RPI_VPN_IP=10.99.0.10
ADMIN_VPN_IP=10.99.0.20

# Address lnd-server binds its p2p listener to.
LND_BIND_IP=10.99.0.1

# lnd-server reaches bitcoind on loopback (same network namespace).
BITCOIND_RPCHOST=127.0.0.1:18443
BITCOIND_ZMQBLOCK=tcp://127.0.0.1:28332
BITCOIND_ZMQTX=tcp://127.0.0.1:28333

# Seconds between automatically mined blocks. 600 = 10 minutes, matching
# mainnet cadence. Use scripts/65-mine.sh to mine on demand during a test.
MINE_INTERVAL=600
