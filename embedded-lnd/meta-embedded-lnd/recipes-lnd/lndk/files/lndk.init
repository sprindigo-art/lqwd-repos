#!/bin/sh
### BEGIN INIT INFO
# Provides:          lndk
# Required-Start:    $local_fs $network lnd
# Required-Stop:     $local_fs $network lnd
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: BOLT 12 offers for lnd
### END INIT INFO

NAME=lndk
WRAPPER=/usr/libexec/lndk-run
PIDFILE=/run/lndk.pid

test -x "$WRAPPER" || exit 0

is_running() {
    [ -f "$PIDFILE" ] || return 1
    kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

case "$1" in
  start)
        if is_running; then
            echo "$NAME is already running."
            exit 0
        fi
        echo -n "Starting $NAME: "
        rm -f "$PIDFILE"
        # The wrapper waits for lnd's macaroons and for the wallet to be
        # unlocked, then execs lndk in place - so this pid stays valid.
        start-stop-daemon --start --quiet --background \
            --make-pidfile --pidfile "$PIDFILE" --exec "$WRAPPER"
        echo "done."
        ;;
  stop)
        echo -n "Stopping $NAME: "
        if ! is_running; then
            rm -f "$PIDFILE"
            echo "not running."
            exit 0
        fi
        kill "$(cat "$PIDFILE")" 2>/dev/null
        i=0
        while [ "$i" -lt 15 ]; do
            is_running || break
            sleep 1
            i=$((i + 1))
        done
        is_running && kill -9 "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
        echo "done."
        ;;
  status)
        if is_running; then
            echo "$NAME is running (pid $(cat "$PIDFILE"))."
        else
            echo "$NAME is not running."
            exit 1
        fi
        ;;
  restart|force-reload)
        $0 stop
        $0 start
        ;;
  *)
        echo "Usage: $0 {start|stop|status|restart|force-reload}"
        exit 1
        ;;
esac

exit 0
