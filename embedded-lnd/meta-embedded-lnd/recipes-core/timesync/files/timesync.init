#!/bin/sh
### BEGIN INIT INFO
# Provides:          timesync
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Set and discipline the system clock over NTP
### END INIT INFO

NAME=timesync
PIDFILE=/run/ntpd.pid

NTP_SERVERS="192.168.1.1 pool.ntp.org time.cloudflare.com"
INITIAL_TIMEOUT=25
[ -r /etc/default/timesync ] && . /etc/default/timesync

DAEMON=$(command -v ntpd 2>/dev/null)
[ -n "$DAEMON" ] || DAEMON=/usr/sbin/ntpd

peer_args() {
    args=""
    for s in $NTP_SERVERS; do
        args="$args -p $s"
    done
    echo "$args"
}

case "$1" in
  start)
        if [ ! -x "$DAEMON" ]; then
            echo "$NAME: ntpd not present - is CONFIG_NTPD enabled in busybox?" >&2
            exit 1
        fi

        PEERS=$(peer_args)

        # Step the clock BEFORE anything that validates a certificate.
        # This board has no RTC: it starts at the rootfs build date, which is
        # years in the past, and OpenVPN would reject the server certificate
        # as not yet valid. busybox ntpd has no bounded-wait option of its own,
        # so run the one-shot in the background and poll it.
        echo -n "Setting clock from NTP: "
        $DAEMON -q -n $PEERS >/dev/null 2>&1 &
        oneshot=$!
        i=0
        while [ "$i" -lt "$INITIAL_TIMEOUT" ]; do
            kill -0 "$oneshot" 2>/dev/null || break
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$oneshot" 2>/dev/null; then
            kill "$oneshot" 2>/dev/null
            echo "timed out after ${INITIAL_TIMEOUT}s (continuing; ntpd will keep trying)."
        else
            echo "$(date)."
        fi

        # Then run continuously to correct drift.
        echo -n "Starting $NAME: "
        start-stop-daemon --start --quiet --background \
            --make-pidfile --pidfile $PIDFILE \
            --exec $DAEMON -- -n $PEERS
        echo "done."
        ;;
  stop)
        echo -n "Stopping $NAME: "
        if [ -f "$PIDFILE" ]; then
            kill "$(cat $PIDFILE)" 2>/dev/null
            rm -f "$PIDFILE"
        fi
        echo "done."
        ;;
  status)
        # busybox start-stop-daemon has no --status, so check the pidfile.
        if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
            echo "$NAME is running (pid $(cat $PIDFILE)). Time now: $(date)"
        else
            echo "$NAME is not running. Time now: $(date)"
            exit 1
        fi
        ;;
  restart|force-reload)
        $0 stop
        sleep 1
        $0 start
        ;;
  *)
        echo "Usage: $0 {start|stop|status|restart|force-reload}"
        exit 1
        ;;
esac

exit 0
