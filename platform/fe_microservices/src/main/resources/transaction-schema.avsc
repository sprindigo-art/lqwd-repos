{
	"type": "record",
	"name": "Tmessage",
	"namespace": "com.lqwd.schema",
	"doc" : "this is the message schema that is used to communicate between FE<->kafka<->BE",
	"fields": [
	{
		"name": "id",
		"type": "int",
		"doc" : "id of this message"
	},
	{
        "name": "user_id",
        "type": "int",
        "doc" : "user id of the user who initiated this action/message"
    },
	{
		"name": "requested_action",
		"type": ["string"],
		"default": "transaction ",
		"doc":"the action that is requested"
	},

	{
		"name": "description",
		"type": ["null","string"],
		"default" : null,
		"doc" : "description of the message or requested action  (if required)"
	},
	{
        "name": "node_id",
        "type": ["string"],
        "default": "lnd-dev",
        "doc": "the id of the LND node that this message is meant for"
    },

	{
		"name": "reply_node_id",
		"type": ["string"],
		"default": "lnd-dev",
		"doc": "the id of the LND node that supplied the information"
	},
	{
        "name": "reply_id",
        "type": "int",
        "doc" : "id of the message that this is a reply to"
    },
	{
		"name": "reply_message",
		"type": ["null","string"],
		"default": null,
		"doc" : "reply to the action requested"
	},
	{
        "name": "error",
        "type": ["boolean"],
        "default" : false,
        "doc" : "a flag to throw if an error has been encountered"
    },
	{
        "name": "error_desc",
        "type": ["null", "string"],
        "default" : null,
        "doc" : "description/ body of an error"
    }


	]
}
