FROM ubuntu:20.10 as builder
RUN apt-get update
RUN apt-get -y install build-essential
RUN apt-get -y install libevent-dev
RUN apt-get -y install libboost-dev libboost-system-dev libboost-filesystem-dev libboost-test-dev
RUN apt-get -y install pkg-config

RUN apt-get -y install libsqlite3-dev
#(only needed when legacy wallet enabled)

RUN apt-get install -y bsdmainutils #hexdump is in this pkg


RUN apt-get -y install git
RUN apt-get -y install autoconf automake libtool
RUN apt-get -y install g++
RUN apt-get -y install vim

ARG THREADS=4

RUN git clone https://github.com/lightningriders/bitcoin.git

RUN cd bitcoin \
    && ./autogen.sh \
    && ./configure \
    && make -j ${THREADS}

RUN cd bitcoin/src \
    && cp bitcoind /usr/bin \
    && cp bitcoin-cli /usr/bin
           
EXPOSE 18443

ENTRYPOINT /bin/bash
