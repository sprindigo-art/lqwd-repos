ALICE_HOST = <alice host>
ALICE_MACAROON = <alice admin.macaroon hex>
ALICE_CERT = <alice cert - new lines replaced with \\n >
BOB_PUBKEY = <Bob public key>
BOB_HOST = <Bob host>
BOB_PEER_URL = <Bob peer url e.g slnd-32445.lqwd-lnd:32840>
BOB_MACAROON = <Bob admin.macaroon>
BOB_CERT = <bob cert - new lines replaced with \\n >
KAFKA_USER = <kafka username>
KAFKA_PASSWORD = <Kafka password>
KAFKA_BROKER = <Kafka broker>