pipeline {
    agent none
    parameters {

        booleanParam(name: 'checkDataChange', defaultValue: true, description: 'check data change before running the pipeline')

    }

    environment {
      GIT_SSH_COMMAND = "ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no"
      PROJECT_NAME = "frontend"
      PROJECT_FOLDER = 'frontend'
      registry = '514063904685.dkr.ecr.us-west-2.amazonaws.com/frontend'
      registryCredential = 'aws-ecr'
      registryURL = "https://514063904685.dkr.ecr.us-west-2.amazonaws.com/frontend"
      gitUrl = 'git@github.com:lightningriders/platform.git'
      gitCredential = 'github-ssh'
      gitBranch = 'develop'
      k8sNamespace = 'microservice'
      environment = 'dev'
      KUBE_CONFIG_ID = "kubeconfig-newdev"
    }

    tools {
      maven 'm3'
    }
    
  stages {  
    stage('Checkout Source') {
       agent {
           label "master"
        }
        steps {
            cleanWs()
            git credentialsId: gitCredential, url: gitUrl, branch: gitBranch 
            sh "ls -la"
        }
    }
    
    stage('Build') {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
           label "master"
        }
        steps {
          dir("${env.PROJECT_NAME}") {
            sh 'mkdir build'
            sh 'cp pom.xml build/'
            sh 'cp -r src build/'
            sh '''
                  cd build
                  mvn clean package -Dmaven.test.skip=true
              '''
            sh 'ls -la build/'
          }
        }
    }
      
    stage ('Test') {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
           label "master"
        }
        steps {
          dir("${env.PROJECT_NAME}") {
            sh 'echo \'Here we have to run tests\''
            sh '''
                  cd build
                  mvn test
              '''
          }
        }
    }
    
    stage ('Build Image') {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
           label "master"
        }
        steps {
          dir("${env.PROJECT_NAME}") {
            script {
                dockerImage = docker.build registry + ":" + "$environment-$BUILD_NUMBER"
            }
          }
        }
    }
    
    stage("Push image") {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
           label "master"
        }
        steps {
            script {
                docker.withRegistry("https://" + registry , "ecr:us-west-2:" + registryCredential) {
                    dockerImage.push(environment + "-latest")
                    dockerImage.push(environment + "-$BUILD_NUMBER")
                }
            }
        }
    }

    stage('Deploy App') {
        when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
        }
        agent {
         kubernetes {
        	cloud 'kubernetes-new' + environment
      	    defaultContainer 'jnlp'
         }
        }
        steps {
            git credentialsId: gitCredential, url: gitUrl, branch: gitBranch
            dir("${env.PROJECT_NAME}") {
              script {
                  kubernetesDeploy( kubeconfigId: "${env.KUBE_CONFIG_ID}",
                                    configs: "namespace.yml"
                                  )
                  sleep(time:5,unit:"SECONDS")
                  kubernetesDeploy( kubeconfigId: "${env.KUBE_CONFIG_ID}",
                                    configs: "${env.PROJECT_NAME}-deployment.yml"
                                    // ,
                                    // secretName: 'ecr-token',
                                    // dockerCredentials: [
                                    //     [credentialsId: 'ecr:us-west-2:aws-ecr', url: registry]
                                    // ],
                                    // secretNamespace: k8sNamespace
                                  )
                  kubernetesDeploy( kubeconfigId:  "${env.KUBE_CONFIG_ID}",
                                    configs: "${env.PROJECT_NAME}-service.yml"
                                  )
                  kubernetesDeploy( kubeconfigId:  "${env.KUBE_CONFIG_ID}",
                                    configs: "${env.PROJECT_NAME}-hpa.yml"
                                  )
              }
            }
        }
    }
    stage('Remove Unused docker image') {
      when {
            anyOf{ 
                changeset "**/${env.PROJECT_FOLDER}/**"
                expression{params.checkDataChange == false}
            }
      }
      agent {
           label "master"
      }
      steps{
        sh "docker rmi $registry:$environment-$BUILD_NUMBER"
      }
    }
  }
}
