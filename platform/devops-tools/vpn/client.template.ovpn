client
pull-filter ignore "redirect-gateway" 
dev tun
proto udp
remote 192.243.215.110 19224
resolv-retry infinite
nobind
persist-key
persist-tun
cipher AES-256-CBC
verb 3
remote-cert-tls server

# <ca>
# -----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----
# </ca>

# <cert>
# -----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----
# </cert>

# <key>
# -----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----
# </key>